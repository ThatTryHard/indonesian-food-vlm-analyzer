    "def resolve_image_path(image_name, base_dir=RECIPE_IMG_DIR):\n",
    "    base = Path(base_dir)\n",
    "    # Coba beberapa ekstensi umum\n",
    "    for ext in ['.jpg', '.jpeg', '.png']:\n",
    "        p = base / f'{image_name}{ext}'\n",
