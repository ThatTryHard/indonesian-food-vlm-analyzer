     "shell.execute_reply": "2026-06-29T03:18:31.720857Z",
     "shell.execute_reply.started": "2026-06-29T03:18:31.709443Z"
    },
    "id": "f458fbf2",
    "papermill": {
     "duration": 0.029158,
     "end_time": "2026-05-31T11:35:24.801182+00:00",
     "exception": false,
     "start_time": "2026-05-31T11:35:24.772024+00:00",
